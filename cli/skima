#!/usr/bin/env bash
# Skima CLI — install active Library capabilities into detected Agents.
# See CONTEXT.md at the monorepo root for the domain model this script follows.
#
# Exit codes:
#   0  success
#   1  operational failure (install failures, sync failures, all Sources unreachable)
#   2  usage error (unknown command, missing sources.json)
#   3  missing external dependency (python3, rsync, git)
set -euo pipefail

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Resolve the monorepo root as the parent of this script's real directory,
# following symlinks so `skima` still works if it's symlinked onto PATH.
# Hand-rolled because BSD/macOS `readlink` has no -f.
resolve_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  local script_dir
  script_dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  (cd -P "$script_dir/.." >/dev/null 2>&1 && pwd)
}

ROOT="$(resolve_root)"
RENDER_PY="$ROOT/cli/render.py"
LIBRARY_DIR="$ROOT/library"
SOURCES_JSON="$ROOT/sources.json"
STATUS_DIR="$ROOT/.skima"
STATUS_FILE="$STATUS_DIR/status.json"

# ---------------------------------------------------------------------------
# Agents and Install targets
#
# CONTEXT.md: an Install target is an Agent Skima has DETECTED on the machine.
# Detection is keyed off the Agent's own config directory — that directory
# exists because the Agent is installed, so it is the honest signal. The
# `skills/` subdirectory underneath it is Skima's to create on first Install
# (CONTEXT.md: "created on first Install if missing").
#
# Skima never creates a config directory, and therefore never leaves a tree
# behind for an Agent the user does not have installed.
# ---------------------------------------------------------------------------

# One row per known Agent: key<TAB>label<TAB>detect-path<TAB>skills-path.
# Kept as a function (not an associative array) because macOS ships bash 3.2.
agent_table() {
  printf '%s\t%s\t%s\t%s\n' "cursor"   "Cursor"          "$HOME/.cursor"                           "$HOME/.cursor/skills"
  printf '%s\t%s\t%s\t%s\n' "claude"   "Claude Code"     "$HOME/.claude"                           "$HOME/.claude/skills"
  # Pi's global resource directory can be overridden with PI_CODING_AGENT_DIR.
  # Its default is ~/.pi/agent; skills live in the skills/ child directory.
  local pi_agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  printf '%s\t%s\t%s\t%s\n' "pi"       "Pi"              "$pi_agent_dir"                          "$pi_agent_dir/skills"
  # OpenCode follows XDG_CONFIG_HOME when set and keeps global skills in
  # <config>/opencode/skills. The config directory is the detection signal.
  local opencode_config="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
  printf '%s\t%s\t%s\t%s\n' "opencode" "OpenCode"        "$opencode_config"                       "$opencode_config/skills"
  # No single config dir identifies the shared ~/.agents convention, so the
  # skills directory itself is the detection signal: Skima uses it when it is
  # already there and never creates it.
  printf '%s\t%s\t%s\t%s\n' "agents"   "Shared agents dir" "$HOME/.agents/skills"                    "$HOME/.agents/skills"
}

# Every skills path Skima is ever allowed to write inside, detected or not.
# Used by the destructive-operation guard below.
TARGET_ROOTS=()
while IFS=$'\t' read -r _k _l _d skills_path; do
  [ -n "${skills_path:-}" ] && TARGET_ROOTS+=("$skills_path")
done < <(agent_table)

# Refuses any path that is not exactly "<known skills root>/<one component>".
# Every rm/mv Skima performs inside a target goes through this first, so an
# empty or unexpanded variable can never widen into a catastrophic path.
guard_target_path() {
  local p="${1:-}" root parent base
  [ -n "$p" ] || return 1
  case "$p" in
    */) return 1 ;;
    *"/../"*|*/..) return 1 ;;
  esac
  parent="${p%/*}"
  base="${p##*/}"
  [ -n "$parent" ] || return 1
  [ -n "$base" ] || return 1
  case "$base" in .|..) return 1 ;; esac
  for root in ${TARGET_ROOTS[@]+"${TARGET_ROOTS[@]}"}; do
    if [ "$parent" = "$root" ]; then
      return 0
    fi
  done
  return 1
}

# Guarded rm. Silently refuses anything guard_target_path rejects.
discard_path() {
  local p="${1:-}"
  [ -n "$p" ] || return 0
  guard_target_path "$p" || return 1
  rm -rf -- "$p" 2>/dev/null || true
  return 0
}

# ---------------------------------------------------------------------------
# Output: color only when stdout is a TTY and NO_COLOR isn't set. Every
# message must stay readable with these as empty strings.
# ---------------------------------------------------------------------------

supports_color() {
  [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]
}

if supports_color; then
  COLOR_ENABLED=1
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'
else
  COLOR_ENABLED=0
  C_RESET=""
  C_BOLD=""
  C_DIM=""
  C_GREEN=""
  C_YELLOW=""
  C_RED=""
fi

export SKIMA_COLOR="$COLOR_ENABLED"

# ---------------------------------------------------------------------------
# Optional pretty rendering (cli/render.py + the `rich` package).
#
# Skima runs from a fresh clone with nothing installed, so rendering is a
# best-effort upgrade, never a requirement. Every call site is
#
#     render <subcommand> <<< "$rows" || plain_fallback
#
# and the plain fallback below each one is the whole output that ships without
# rich — which is also the only thing python3-free machines ever see, keeping
# `install`, `list`, `targets` and `root` python3-optional exactly as before.
#
# render.py buffers its entire output and writes stdout once, at the end, so a
# failure part-way through can never produce half a table followed by the
# fallback's full one. Its stderr is discarded: a missing dependency is not the
# user's problem to read about.
# ---------------------------------------------------------------------------

render() {
  [ -f "$RENDER_PY" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 "$RENDER_PY" "$@" 2>/dev/null
}

rel_path() {
  local p="$1"
  case "$p" in
    "$ROOT"/*) printf '%s\n' "${p#"$ROOT"/}" ;;
    *) printf '%s\n' "$p" ;;
  esac
}

tilde_path() {
  local p="$1"
  case "$p" in
    "$HOME"/*) printf '%s\n' "~${p#"$HOME"}" ;;
    *) printf '%s\n' "$p" ;;
  esac
}

plural() {
  if [ "$1" -eq 1 ]; then printf '%s' "$2"; else printf '%s' "$3"; fi
}

need_cmd() {
  local c="$1"
  if ! command -v "$c" >/dev/null 2>&1; then
    echo "skima: '$c' is required but was not found on PATH" >&2
    exit 3
  fi
}

# Field separator for internal name/url/sha/status rows below. Deliberately
# NOT a tab: bash's `read`/word-splitting treats tab as IFS whitespace and
# collapses consecutive delimiters, which silently eats empty fields (e.g. a
# blank "remote" sha when a source is unreachable). \x1f (ASCII Unit
# Separator) is never collapsed and never appears in URLs/shas/names.
FS=$'\x1f'

# ---------------------------------------------------------------------------
# Library discovery
#
# The DIRECTORY is authoritative for a Capability's Status, Id and Bucket:
#
#   library/<bucket>/<id>/              -> Status active
#   library/deprecated/<bucket>/<id>/   -> Status deprecated
#
# Discovery is anchored at exactly that depth, so support material nested
# inside a Capability (e.g. library/thinking/socratic-method/docs/de/SKILL.md)
# is part of that Capability and never a Capability of its own.
#
# A disagreeing .skima.json is a validation warning, never an override — a
# stale "status": "active" under library/deprecated/ can therefore not cause
# an Install.
# ---------------------------------------------------------------------------

# The Kind enum from CONTEXT.md. Kept as a space-separated string (not an
# array) so membership is a single `case` test on macOS bash 3.2.
VALID_KINDS="skill hook plugin agent"

# True when a directory is the root of a Capability. .skima.json is the
# primary marker; SKILL.md is accepted for Capabilities not yet given one.
is_capability_dir() {
  local d="$1"
  [ -f "${d}.skima.json" ] || [ -f "${d}SKILL.md" ]
}

# Prints "<status>\t<bucket>\t<id>\t<absolute path>" for every Capability,
# active and deprecated, sorted by bucket then id.
list_capabilities() {
  {
    local bucket_path bucket cap_path id
    for bucket_path in "$LIBRARY_DIR"/*/; do
      [ -d "$bucket_path" ] || continue
      bucket="$(basename "$bucket_path")"
      if [ "$bucket" = "deprecated" ]; then
        continue
      fi
      for cap_path in "$bucket_path"*/; do
        [ -d "$cap_path" ] || continue
        is_capability_dir "$cap_path" || continue
        id="$(basename "$cap_path")"
        printf 'active\t%s\t%s\t%s\n' "$bucket" "$id" "$(cd "$cap_path" && pwd)"
      done
    done

    for bucket_path in "$LIBRARY_DIR"/deprecated/*/; do
      [ -d "$bucket_path" ] || continue
      bucket="$(basename "$bucket_path")"
      for cap_path in "$bucket_path"*/; do
        [ -d "$cap_path" ] || continue
        is_capability_dir "$cap_path" || continue
        id="$(basename "$cap_path")"
        printf 'deprecated\t%s\t%s\t%s\n' "$bucket" "$id" "$(cd "$cap_path" && pwd)"
      done
    done
  } | sort -t$'\t' -k2,2 -k3,3
}

# Prints "<bucket>\t<id>\t<absolute path>" for Status active only. This is the
# exact set Install materializes (CONTEXT.md: Install includes every Capability
# with Status active; deprecated Capabilities are never installed).
list_active_capabilities() {
  list_capabilities | awk -F'\t' '$1 == "active" { print $2 "\t" $3 "\t" $4 }'
}

# Prints one human-readable warning per line where a Capability's .skima.json
# disagrees with the directory, is missing, or is unreadable. Never fails the
# caller: metadata problems are reported, not enforced. Skipped entirely when
# python3 is unavailable, since Install must keep working without it.
library_warnings() {
  command -v python3 >/dev/null 2>&1 || return 0
  list_capabilities | python3 -c '
import json, os, sys

for line in sys.stdin:
    line = line.rstrip("\n")
    if not line:
        continue
    status, bucket, cap_id, path = line.split("\t", 3)
    rel = os.path.join("library", "deprecated" if status == "deprecated" else "", bucket, cap_id)
    rel = rel.replace("//", "/")
    meta_path = os.path.join(path, ".skima.json")
    if not os.path.isfile(meta_path):
        print(f"{rel}: no .skima.json (Status/Id/Bucket taken from the directory)")
        continue
    try:
        with open(meta_path, encoding="utf-8") as f:
            meta = json.load(f)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"{rel}: .skima.json could not be read ({exc}); directory wins")
        continue
    if not isinstance(meta, dict):
        print(f"{rel}: .skima.json is not a JSON object; directory wins")
        continue
    for field, actual in (("status", status), ("bucket", bucket), ("id", cap_id)):
        declared = meta.get(field)
        if declared is not None and declared != actual:
            print(f"{rel}: .skima.json {field}=\"{declared}\" disagrees with the directory "
                  f"({field}=\"{actual}\"); directory wins")
' || true
}

print_library_warnings() {
  local warnings w
  warnings="$(library_warnings)"
  [ -n "$warnings" ] || return 0
  echo "${C_YELLOW}Library validation warnings${C_RESET} (directory is authoritative):"
  while IFS= read -r w; do
    [ -n "$w" ] && echo "  $w"
  done <<< "$warnings"
  echo
}

# Same warnings as one "warn<FS>text" row each, for the renderer.
library_warning_rows() {
  local w
  while IFS= read -r w; do
    [ -n "$w" ] && printf 'warn%s%s\n' "$FS" "$w"
  done < <(library_warnings)
  return 0
}

# ---------------------------------------------------------------------------
# Install primitive: symlink first, copy fallback, never a destructive gap.
#
# The replacement is fully materialized at a sibling temp path BEFORE anything
# at the destination is touched. The destination is then moved aside with a
# single atomic rename, the staged entry renamed into its place, and only then
# is the old copy discarded. If the final rename fails the original is put
# back. At no point does a window exist where the destination has been removed
# and no replacement is ready.
#
# Sets INSTALL_RESULT to: linked | copied | skipped | <error message>.
# ---------------------------------------------------------------------------

INSTALL_RESULT=""

install_one() {
  local dest="$1" src="$2"
  INSTALL_RESULT=""

  if ! guard_target_path "$dest"; then
    INSTALL_RESULT="refused: '$dest' is not directly inside a known install target"
    return 1
  fi

  # Already the symlink we want — leave it completely alone.
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    INSTALL_RESULT="skipped"
    return 0
  fi


  local tmp="${dest}.skima-tmp-$$"
  discard_path "$tmp" || true

  # 1. Materialize the replacement out of the way. Symlink first; copy only
  #    when the symlink genuinely could not be created (ADR-0002).
  local method=""
  if ln -s "$src" "$tmp" 2>/dev/null; then
    method="linked"
  else
    discard_path "$tmp" || true
    # Symlinks are unavailable here, so this Capability lives as a copy
    # (ADR-0002). A copy is a directory, not the symlink tested above, so
    # without this check it would be re-copied on every single install. If the
    # content already matches, there is nothing to do. Any difference at all —
    # including a file the Agent added — falls through and is replaced, which
    # is the safe direction to err in.
    if [ ! -L "$dest" ] && [ -d "$dest" ] && [ -d "$src" ] \
       && diff -rq "$src" "$dest" >/dev/null 2>&1; then
      INSTALL_RESULT="skipped"
      return 0
    fi
    if cp -R "$src" "$tmp" 2>/dev/null; then
      method="copied"
    else
      discard_path "$tmp" || true
      INSTALL_RESULT="could not stage a symlink or a copy"
      return 1
    fi
  fi

  # 2. Move any existing entry aside (atomic rename, nothing destroyed yet).
  local backup=""
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    backup="${dest}.skima-old-$$"
    discard_path "$backup" || true
    if ! mv -- "$dest" "$backup" 2>/dev/null; then
      discard_path "$tmp" || true
      INSTALL_RESULT="could not move the existing entry aside"
      return 1
    fi
  fi

  # 3. Swap the staged entry in (atomic rename).
  if mv -- "$tmp" "$dest" 2>/dev/null; then
    if [ -n "$backup" ]; then
      discard_path "$backup" || true
    fi
    INSTALL_RESULT="$method"
    return 0
  fi

  # 4. Swap failed — restore the original exactly as it was.
  if [ -n "$backup" ]; then
    mv -- "$backup" "$dest" 2>/dev/null || true
  fi
  discard_path "$tmp" || true
  INSTALL_RESULT="could not swap the staged entry into place"
  return 1
}

# ---------------------------------------------------------------------------
# Network helpers: bound how long we'll wait on an unreachable remote.
# ---------------------------------------------------------------------------

SKIMA_NETWORK_TIMEOUT="${SKIMA_NETWORK_TIMEOUT:-10}"

# Runs "$@" with a wall-clock timeout in seconds, since neither `timeout` nor
# `gtimeout` are guaranteed to be installed. Prints the command's combined
# output and returns its exit code, or 124 on timeout.
with_timeout() {
  local secs="$1"; shift
  local out_file
  out_file="$(mktemp "${TMPDIR:-/tmp}/skima-timeout-XXXXXX")"

  ("$@" >"$out_file" 2>&1) &
  local pid=$!
  local waited=0
  local max=$((secs * 5))

  while kill -0 "$pid" 2>/dev/null; do
    if [ "$waited" -ge "$max" ]; then
      pkill -TERM -P "$pid" 2>/dev/null || true
      kill -TERM "$pid" 2>/dev/null || true
      sleep 0.3
      pkill -KILL -P "$pid" 2>/dev/null || true
      kill -KILL "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      cat "$out_file"
      rm -f "$out_file"
      return 124
    fi
    sleep 0.2
    waited=$((waited + 1))
  done

  local rc=0
  wait "$pid" || rc=$?
  cat "$out_file"
  rm -f "$out_file"
  return "$rc"
}

# Resolves the remote HEAD sha for a git URL, trying HEAD then common default
# branch refs. Prints the sha on stdout and returns 0, or returns 1 if the
# remote could not be reached / resolved.
git_remote_head() {
  local url="$1"
  local ref out sha

  export GIT_TERMINAL_PROMPT=0
  : "${GIT_SSH_COMMAND:=ssh -o BatchMode=yes -o ConnectTimeout=$SKIMA_NETWORK_TIMEOUT -o StrictHostKeyChecking=accept-new}"
  export GIT_SSH_COMMAND

  for ref in HEAD refs/heads/main refs/heads/master; do
    if out="$(with_timeout "$SKIMA_NETWORK_TIMEOUT" git ls-remote "$url" "$ref" 2>/dev/null)"; then
      sha="$(printf '%s\n' "$out" | awk '{print $1}' | head -n1)"
      if [ -n "$sha" ]; then
        printf '%s' "$sha"
        return 0
      fi
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# Source helpers: read/write sources.json and .skima/status.json.
# Source list parsing and JSON I/O use python3 (stdlib-only, same convention
# as web/server.py) since bash has no safe native JSON support.
# ---------------------------------------------------------------------------

ensure_sources_json_or_die() {
  need_cmd python3
  if [ ! -f "$SOURCES_JSON" ]; then
    echo "skima: sources.json not found at $(rel_path "$SOURCES_JSON")" >&2
    exit 2
  fi
}

# Prints "name<FS>url<FS>revision" for each source in sources.json, one per
# line, sorted by name. With args, filters to just those names.
list_sources() {
  python3 - "$SOURCES_JSON" "$@" <<'PY'
import json
import sys

FS = "\x1f"
path = sys.argv[1]
filter_names = set(sys.argv[2:])

with open(path, encoding="utf-8") as f:
    data = json.load(f)

sources = data.get("sources", {}) or {}
names = sorted(sources)
if filter_names:
    names = [n for n in names if n in filter_names]

for name in names:
    s = sources[name] or {}
    print(FS.join([name, s.get("url", ""), s.get("revision", "")]))
PY
}

# Populates the global CHECK_ROWS array with one FS-separated row per source:
# name<FS>url<FS>pinned<FS>remote<FS>status<FS>error (remote/error are "" when
# absent). Also sets CHECK_TOTAL and CHECK_UNREACHABLE. With args, restricts
# to those source names (used by `sync` to re-check just what it touched).
CHECK_ROWS=()
CHECK_TOTAL=0
CHECK_UNREACHABLE=0

collect_check_rows() {
  local rows
  rows="$(list_sources "$@")" || return 1

  CHECK_ROWS=()
  CHECK_TOTAL=0
  CHECK_UNREACHABLE=0

  local name url pinned remote status err
  while IFS="$FS" read -r name url pinned; do
    [ -z "$name" ] && continue
    CHECK_TOTAL=$((CHECK_TOTAL + 1))
    remote=""
    err=""
    if remote="$(git_remote_head "$url")"; then
      if [ "$remote" = "$pinned" ]; then
        status="up-to-date"
      else
        status="behind"
      fi
    else
      remote=""
      status="unreachable"
      err="git ls-remote failed (network unreachable, auth required, or repository moved)"
      CHECK_UNREACHABLE=$((CHECK_UNREACHABLE + 1))
    fi
    CHECK_ROWS+=("${name}${FS}${url}${FS}${pinned}${FS}${remote}${FS}${status}${FS}${err}")
  done <<< "$rows"

  return 0
}

colorize_status() {
  local status="$1"
  case "$status" in
    up-to-date)   printf '%s%s%s' "$C_GREEN" "$status" "$C_RESET" ;;
    behind)       printf '%s%s%s' "$C_YELLOW" "$status" "$C_RESET" ;;
    unreachable)  printf '%s%s%s' "$C_RED" "$status" "$C_RESET" ;;
    *)            printf '%s' "$status" ;;
  esac
}

# Renders CHECK_ROWS. $1 is the rendered section title; $2 is an optional line
# the plain fallback prints in its place (the rendered rule carries that context
# for free, the bare table does not).
print_check_table() {
  [ "${#CHECK_ROWS[@]}" -gt 0 ] || return 0
  local title="${1:-Check}" plain_header="${2:-}"
  if printf '%s\n' "${CHECK_ROWS[@]}" | render check "$title"; then
    return 0
  fi
  [ -n "$plain_header" ] && echo "$plain_header"
  print_check_table_plain
}

print_check_table_plain() {
  [ "${#CHECK_ROWS[@]}" -gt 0 ] || return 0
  printf '%s%-26s  %-12s  %-12s  %s%s\n' "$C_BOLD" "NAME" "PINNED" "REMOTE" "STATUS" "$C_RESET"
  local row name url pinned remote status err pinned_short remote_short
  for row in ${CHECK_ROWS[@]+"${CHECK_ROWS[@]}"}; do
    IFS="$FS" read -r name url pinned remote status err <<< "$row"
    pinned_short="${pinned:0:12}"
    remote_short="—"
    [ -n "$remote" ] && remote_short="${remote:0:12}"
    printf '%-26s  %-12s  %-12s  %s\n' "$name" "$pinned_short" "$remote_short" "$(colorize_status "$status")"
  done
}

# Writes CHECK_ROWS to .skima/status.json. mode "full" replaces the whole
# sources map (used by `check`); mode "merge" only updates the rows present
# and preserves other existing entries (used by `sync` for the sources it
# touched). Handles an empty CHECK_ROWS (bash 3.2 errors on "${arr[@]}" when
# the array is empty under `set -u`).
write_status_json() {
  local mode="${1:-full}"
  local rows_file
  rows_file="$(mktemp "${TMPDIR:-/tmp}/skima-rows-XXXXXX")"
  if [ "${#CHECK_ROWS[@]}" -gt 0 ]; then
    printf '%s\n' "${CHECK_ROWS[@]}" > "$rows_file"
  else
    : > "$rows_file"
  fi

  local rc=0
  python3 - "$STATUS_FILE" "$mode" "$rows_file" <<'PY' || rc=$?
import json
import sys
import datetime

FS = "\x1f"
out_path, mode, rows_path = sys.argv[1], sys.argv[2], sys.argv[3]

existing = {}
try:
    with open(out_path, encoding="utf-8") as f:
        loaded = json.load(f)
        if isinstance(loaded, dict):
            existing = loaded
except (FileNotFoundError, json.JSONDecodeError):
    pass

sources = dict(existing.get("sources", {})) if mode == "merge" else {}

with open(rows_path, encoding="utf-8") as f:
    for line in f:
        line = line.rstrip("\n")
        if not line:
            continue
        name, url, pinned, remote, status, error = line.split(FS)
        sources[name] = {
            "url": url,
            "pinned": pinned,
            "remote": remote or None,
            "status": status,
            "error": error or None,
        }

payload = {
    "checked_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "sources": sources,
}

with open(out_path, "w", encoding="utf-8") as f:
    json.dump(payload, f, indent=2)
    f.write("\n")
PY
  rm -f "$rows_file"
  return "$rc"
}

# Updates a single source's pinned revision in sources.json in place,
# preserving key order and 2-space indent.
update_source_revision() {
  local name="$1" sha="$2"
  python3 - "$SOURCES_JSON" "$name" "$sha" <<'PY'
import json
import sys

path, name, sha = sys.argv[1], sys.argv[2], sys.argv[3]

with open(path, encoding="utf-8") as f:
    data = json.load(f)

sources = data.setdefault("sources", {})
if name in sources:
    sources[name]["revision"] = sha

with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
}

# Prints "url<FS>path<FS>revision" for one source name from sources.json.
source_record() {
  local name="$1"
  python3 - "$SOURCES_JSON" "$name" <<'PY'
import json
import sys

FS = "\x1f"
path, name = sys.argv[1], sys.argv[2]

with open(path, encoding="utf-8") as f:
    data = json.load(f)

s = (data.get("sources", {}) or {}).get(name)
if s is None:
    sys.exit(1)
print(FS.join([s.get("url", ""), s.get("path", f"sources/{name}"), s.get("revision", "")]))
PY
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# Deliberately just the path, with no label and no decoration beyond bold on a
# TTY: `cd "$(skima root)"` has to keep working, and that is a pipe, so it lands
# on the plain branch anyway.
cmd_root() {
  printf '%s%s%s\n' "$C_BOLD" "$ROOT" "$C_RESET"
}

cmd_list() {
  local rows="" bucket id deprecated
  rows="$(library_warning_rows)"
  [ -n "$rows" ] && rows="${rows}"$'\n'

  while IFS=$'\t' read -r bucket id _src; do
    [ -z "$id" ] && continue
    rows="${rows}cap${FS}${bucket}${FS}${id}"$'\n'
  done < <(list_active_capabilities)

  deprecated="$(list_capabilities | awk -F'\t' '$1 == "deprecated"' | wc -l | tr -d ' ')"
  rows="${rows}dep${FS}${deprecated}"$'\n'

  if printf '%s' "$rows" | render list; then
    return 0
  fi
  cmd_list_plain "$deprecated"
}

cmd_list_plain() {
  local deprecated="$1"
  print_library_warnings
  local count=0 bucket id
  while IFS=$'\t' read -r bucket id _src; do
    [ -z "$id" ] && continue
    printf '  %-12s %s\n' "$bucket" "$id"
    count=$((count + 1))
  done < <(list_active_capabilities)
  echo
  echo "$count active $(plural "$count" capability capabilities)"

  if [ "$deprecated" -gt 0 ]; then
    echo "$deprecated deprecated $(plural "$deprecated" capability capabilities) (never installed)"
  fi
}

cmd_targets() {
  local rows="" _key label detect skills state
  while IFS=$'\t' read -r _key label detect skills; do
    if [ -d "$detect" ]; then
      if [ -d "$skills" ]; then state="detected"; else state="detected-new"; fi
    else
      state="skipped"
    fi
    rows="${rows}target${FS}${label}${FS}$(tilde_path "$skills")${FS}$(tilde_path "$detect")${FS}${state}"$'\n'
  done < <(agent_table)

  if printf '%s' "$rows" | render targets; then
    return 0
  fi
  cmd_targets_plain
}

cmd_targets_plain() {
  echo "Install targets"
  echo
  printf '%s%-20s  %-24s  %s%s\n' "$C_BOLD" "AGENT" "PATH" "DETECTION" "$C_RESET"

  local _key label detect skills detected=0
  while IFS=$'\t' read -r _key label detect skills; do
    if [ -d "$detect" ]; then
      detected=$((detected + 1))
      if [ -d "$skills" ]; then
        printf '%-20s  %-24s  %sdetected%s (%s exists)\n' \
          "$label" "$(tilde_path "$skills")" "$C_GREEN" "$C_RESET" "$(tilde_path "$detect")"
      else
        printf '%-20s  %-24s  %sdetected%s (%s exists; skills dir created on first install)\n' \
          "$label" "$(tilde_path "$skills")" "$C_GREEN" "$C_RESET" "$(tilde_path "$detect")"
      fi
    else
      printf '%-20s  %-24s  %sskipped%s (%s not found — Agent not installed)\n' \
        "$label" "$(tilde_path "$skills")" "$C_DIM" "$C_RESET" "$(tilde_path "$detect")"
    fi
  done < <(agent_table)

  echo
  if [ "$detected" -eq 0 ]; then
    echo "No Agents detected. Skima will not create directories for Agents that are not installed."
  else
    echo "$detected install $(plural "$detected" target targets) detected. Skipped Agents are never written to."
  fi
}

# Reports (and, where safe, cleans) entries at a target that no longer match an
# active Capability.
#
#   * a symlink into this monorepo's library/ that is not an active Capability
#     is something Skima itself created and is now stale (Capability deleted or
#     deprecated) -> removed, so deprecated Capabilities never linger installed.
#     Removing the link never touches the Library copy it points at.
#   * anything else -> reported only, never touched. Skima cannot prove it
#     created it, so it does not get to delete it. This includes copy-fallback
#     entries, which are indistinguishable from a user's own directory.
INSTALL_REMOVED_STALE=0
INSTALL_FOREIGN=()

scan_target_entries() {
  local target="$1"; shift
  local known_ids=("$@")

  INSTALL_REMOVED_STALE=0
  INSTALL_FOREIGN=()

  local entry base known k link_target
  for entry in "$target"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    base="$(basename "$entry")"

    case "$base" in
      *.skima-tmp-*)
        # Staged replacement left behind by an interrupted install. It is
        # either a fresh symlink or a copy of a Library copy — never user data.
        discard_path "$entry" || true
        continue
        ;;
      *.skima-old-*)
        # A previous destination that an interrupted swap moved aside. This
        # may be the only copy of that data, so report it and leave it alone.
        INSTALL_FOREIGN+=("$base (interrupted install leftover — inspect, then remove by hand)")
        continue
        ;;
    esac

    known=0
    for k in ${known_ids[@]+"${known_ids[@]}"}; do
      if [ "$k" = "$base" ]; then
        known=1
        break
      fi
    done
    [ "$known" -eq 1 ] && continue

    if [ -L "$entry" ]; then
      link_target="$(readlink "$entry")"
      case "$link_target" in
        "$LIBRARY_DIR"/*)
          if discard_path "$entry"; then
            INSTALL_REMOVED_STALE=$((INSTALL_REMOVED_STALE + 1))
          fi
          continue
          ;;
      esac
    fi

    INSTALL_FOREIGN+=("$base")
  done
}

# Install does the work first and reports once at the end, so the renderer can
# lay the whole run out as a table. The work itself is symlink swaps — fast
# enough that there is nothing to watch, and the Web UI only ever sees the
# captured result anyway.
#
# PLAIN_LINES collects the exact plain-text report as the work proceeds, so the
# fallback costs nothing extra and cannot drift from the rendered one.
cmd_install() {
  local rows="" plain="" warnings="" w

  warnings="$(library_warnings)"
  if [ -n "$warnings" ]; then
    plain+="${C_YELLOW}Library validation warnings${C_RESET} (directory is authoritative):"$'\n'
    while IFS= read -r w; do
      [ -n "$w" ] || continue
      rows+="warn${FS}${w}"$'\n'
      plain+="  $w"$'\n'
    done <<< "$warnings"
    plain+=$'\n'
  fi

  local total_caps
  total_caps="$(list_active_capabilities | wc -l | tr -d ' ')"

  local target_labels=() target_paths=() skipped_labels=() skipped_detects=()
  local _key label detect skills
  while IFS=$'\t' read -r _key label detect skills; do
    if [ -d "$detect" ]; then
      target_labels+=("$label")
      target_paths+=("$skills")
    else
      skipped_labels+=("$label")
      skipped_detects+=("$(tilde_path "$detect")")
    fi
  done < <(agent_table)

  rows="${rows}head${FS}${ROOT}${FS}${LIBRARY_DIR}${FS}${total_caps}"$'\n'
  plain+="Skima install"$'\n'
  plain+="  monorepo root:       $ROOT"$'\n'
  plain+="  library:             $LIBRARY_DIR"$'\n'
  plain+="  active capabilities: $total_caps"$'\n\n'

  if [ "${#skipped_labels[@]}" -gt 0 ]; then
    local i
    plain+="Skipped (Agent not detected — nothing created):"$'\n'
    for i in "${!skipped_labels[@]}"; do
      rows="${rows}skipped${FS}${skipped_labels[$i]}${FS}${skipped_detects[$i]}"$'\n'
      plain+="  ${skipped_labels[$i]} (${skipped_detects[$i]} not found)"$'\n'
    done
    plain+=$'\n'
  fi

  if [ "${#target_paths[@]}" -eq 0 ]; then
    rows="${rows}notargets${FS}"$'\n'
    plain+="No install targets detected — nothing to do."$'\n'
    printf '%s' "$rows" | render install || printf '%s' "$plain"
    return 0
  fi

  local overall_fail=0
  local idx
  for idx in "${!target_paths[@]}"; do
    local name="${target_labels[$idx]}"
    local target="${target_paths[$idx]}"

    # The Agent is detected; its skills subdirectory is ours to create.
    if ! mkdir -p "$target" 2>/dev/null; then
      rows="${rows}targetfail${FS}${name}${FS}$(tilde_path "$target")"$'\n'
      plain+="[$name] $target"$'\n'
      plain+="  FAILED to create the skills directory"$'\n\n'
      overall_fail=1
      continue
    fi

    local linked=0 copied=0 skipped=0 fail=0
    local fail_msgs=()
    local known_ids=()
    local bucket id src dest

    while IFS=$'\t' read -r bucket id src; do
      [ -z "$id" ] && continue
      known_ids+=("$id")
      dest="$target/$id"
      if install_one "$dest" "$src"; then
        case "$INSTALL_RESULT" in
          linked)  linked=$((linked + 1)) ;;
          copied)  copied=$((copied + 1)) ;;
          skipped) skipped=$((skipped + 1)) ;;
        esac
      else
        fail=$((fail + 1))
        fail_msgs+=("$id: $INSTALL_RESULT")
      fi
    done < <(list_active_capabilities)

    scan_target_entries "$target" ${known_ids[@]+"${known_ids[@]}"}

    rows="${rows}target${FS}${name}${FS}$(tilde_path "$target")${FS}${linked}${FS}${copied}${FS}${skipped}${FS}${fail}${FS}${INSTALL_REMOVED_STALE}"$'\n'
    plain+="[$name] $target"$'\n'
    plain+="  symlinked: $linked   copied: $copied   up-to-date: $skipped   failed: $fail"$'\n'
    if [ "$fail" -gt 0 ]; then
      overall_fail=1
      local m
      for m in "${fail_msgs[@]}"; do
        rows="${rows}fail${FS}${name}${FS}${m}"$'\n'
        plain+="    FAIL $m"$'\n'
      done
    fi
    if [ "$INSTALL_REMOVED_STALE" -gt 0 ]; then
      plain+="  removed $INSTALL_REMOVED_STALE stale skima $(plural "$INSTALL_REMOVED_STALE" symlink symlinks) (capability deleted or deprecated)"$'\n'
    fi
    if [ "${#INSTALL_FOREIGN[@]}" -gt 0 ]; then
      local f
      plain+="  not managed by skima (left untouched):"$'\n'
      for f in "${INSTALL_FOREIGN[@]}"; do
        rows="${rows}foreign${FS}${name}${FS}${f}"$'\n'
        plain+="    $f"$'\n'
      done
    fi
    plain+=$'\n'
  done

  printf '%s' "$rows" | render install || printf '%s' "$plain"

  if [ "$overall_fail" -ne 0 ]; then
    return 1
  fi
}

cmd_check() {
  ensure_sources_json_or_die
  need_cmd git
  mkdir -p "$STATUS_DIR"

  if ! collect_check_rows; then
    echo "skima: failed to parse $(rel_path "$SOURCES_JSON") (is it valid JSON?)" >&2
    exit 2
  fi

  if [ "$CHECK_TOTAL" -eq 0 ]; then
    echo "No sources tracked in $(rel_path "$SOURCES_JSON")."
    write_status_json full
    echo "${C_DIM}Wrote $(rel_path "$STATUS_FILE")${C_RESET}"
    return 0
  fi

  print_check_table "Check"
  write_status_json full

  echo
  echo "${C_DIM}Wrote $(rel_path "$STATUS_FILE")${C_RESET}"

  if [ "$CHECK_UNREACHABLE" -eq "$CHECK_TOTAL" ]; then
    echo
    echo "skima: all sources unreachable" >&2
    return 1
  fi
  return 0
}

# Shallow-clones a source's url at remote HEAD into a temp dir, rsyncs it
# into sources/<name>/ (excluding .git and .DS_Store), and updates its
# pinned revision in sources.json. Prints progress. Never touches library/.
sync_one() {
  local name="$1"
  local url path _revision

  if ! IFS="$FS" read -r url path _revision < <(source_record "$name"); then
    echo "${C_BOLD}${name}${C_RESET}  ${C_RED}FAILED: not found in sources.json${C_RESET}"
    return 1
  fi
  if [ -z "$url" ]; then
    echo "${C_BOLD}${name}${C_RESET}  ${C_RED}FAILED: missing url in sources.json${C_RESET}"
    return 1
  fi
  [ -n "$path" ] || path="sources/$name"

  local dest="$ROOT/$path"
  echo "${C_BOLD}${name}${C_RESET}  ${C_DIM}${url}${C_RESET}"

  echo "  ${C_DIM}resolving remote HEAD...${C_RESET}"
  local sha
  if ! sha="$(git_remote_head "$url")"; then
    echo "  ${C_RED}FAILED: could not reach $url${C_RESET}"
    return 1
  fi
  echo "  ${C_DIM}remote HEAD: $sha${C_RESET}"

  local tmp_dir log_file
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/skima-sync-XXXXXX")"
  log_file="$(mktemp "${TMPDIR:-/tmp}/skima-clone-XXXXXX")"

  echo "  ${C_DIM}cloning to temp dir...${C_RESET}"
  if ! with_timeout 120 git clone --quiet --depth 1 "$url" "$tmp_dir" >"$log_file" 2>&1; then
    echo "  ${C_RED}FAILED: git clone failed${C_RESET}"
    sed 's/^/    /' "$log_file" 2>/dev/null || true
    rm -f "$log_file"
    rm -rf "$tmp_dir"
    return 1
  fi
  rm -f "$log_file"

  local cloned_sha
  cloned_sha="$(git -C "$tmp_dir" rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$cloned_sha" ]; then
    echo "  ${C_RED}FAILED: could not resolve cloned HEAD${C_RESET}"
    rm -rf "$tmp_dir"
    return 1
  fi

  echo "  ${C_DIM}syncing tree into $path/ ...${C_RESET}"
  mkdir -p "$dest"
  if ! rsync -a --delete --exclude='.git' --exclude='.DS_Store' "$tmp_dir/" "$dest/"; then
    echo "  ${C_RED}FAILED: rsync into $path/ failed${C_RESET}"
    rm -rf "$tmp_dir"
    return 1
  fi
  rm -rf "$tmp_dir"

  echo "  ${C_DIM}updating sources.json revision -> ${cloned_sha:0:12}...${C_RESET}"
  update_source_revision "$name" "$cloned_sha"

  echo "  ${C_GREEN}done${C_RESET}: $name @ ${cloned_sha:0:12}"
  return 0
}

cmd_sync() {
  ensure_sources_json_or_die
  need_cmd git
  need_cmd rsync
  mkdir -p "$STATUS_DIR"

  local all_names
  all_names="$(list_sources | cut -d "$FS" -f1)"

  local targets=()
  if [ "$#" -eq 0 ]; then
    local n
    while IFS= read -r n; do
      [ -n "$n" ] && targets+=("$n")
    done <<< "$all_names"
  else
    local name found n
    for name in "$@"; do
      found=0
      while IFS= read -r n; do
        [ "$n" = "$name" ] && found=1 && break
      done <<< "$all_names"
      if [ "$found" -eq 1 ]; then
        targets+=("$name")
      else
        echo "skima: unknown source '$name' (not in sources.json), skipping" >&2
      fi
    done
  fi

  if [ "${#targets[@]}" -eq 0 ]; then
    echo "skima: no sources to sync" >&2
    exit 2
  fi

  echo "${C_BOLD}Skima sync${C_RESET}  ${C_DIM}refresh Source trees from remote HEAD${C_RESET}"
  echo "  ${C_DIM}monorepo root:${C_RESET} $ROOT"
  echo "  ${C_DIM}sources:${C_RESET}       ${#targets[@]}"
  echo

  local synced=() failed=()
  local name
  for name in "${targets[@]}"; do
    if sync_one "$name"; then
      synced+=("$name")
    else
      failed+=("$name")
    fi
    echo
  done

  if [ "${#synced[@]}" -gt 0 ]; then
    if collect_check_rows "${synced[@]}"; then
      print_check_table "Re-check" "Re-checking synced sources..."
      write_status_json merge
      echo
      echo "${C_DIM}Wrote $(rel_path "$STATUS_FILE")${C_RESET}"
    fi
    echo
  fi

  local summary_rows=""
  for name in ${synced[@]+"${synced[@]}"}; do
    summary_rows="${summary_rows}ok${FS}${name}"$'\n'
  done
  for name in ${failed[@]+"${failed[@]}"}; do
    summary_rows="${summary_rows}fail${FS}${name}"$'\n'
  done

  if ! printf '%s' "$summary_rows" | render sync-summary; then
    echo "synced: ${#synced[@]}   failed: ${#failed[@]}"
    if [ "${#failed[@]}" -gt 0 ]; then
      echo "  failed: ${failed[*]}"
    fi
  fi

  if [ "${#failed[@]}" -gt 0 ]; then
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Adoption — Source tree -> Library copy.
#
# CONTEXT.md: Adoption is "the deliberate act of placing a Capability from a
# Source into the Library under a chosen Bucket (with provenance and a pinned
# Revision)". Deliberate is the operative word, so this command:
#
#   * never guesses a Bucket — the caller names it,
#   * never renames — the Id is the upstream directory name (ADR-0006),
#   * never overwrites an existing Library copy. An Id already in the Library
#     means "update this", which is a Change review decision with a diff behind
#     it, not something a second `adopt` should silently do.
#
# The Web UI's "Add to Library" button shells out to exactly this, so both
# surfaces adopt through one implementation.
# ---------------------------------------------------------------------------

# A single path component Skima is willing to create or address on disk.
is_safe_name() {
  local n="${1:-}"
  [ -n "$n" ] || return 1
  case "$n" in
    .|..) return 1 ;;
    .*) return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# Hidden directories an Agent uses to hold project-local Capabilities
# (Claude Code's .claude/skills/, Cursor's .cursor/skills/, the shared
# .agents/skills/). Upstream repositories often ship a skill under one of
# these, so an upstream path may pass through them. Every other dot-prefixed
# segment stays rejected; Buckets and Ids never get this allowance.
AGENT_HOME_DIRS=".claude .cursor .agents"

is_safe_upstream_segment() {
  local n="${1:-}"
  case " $AGENT_HOME_DIRS " in
    *" $n "*) return 0 ;;
  esac
  is_safe_name "$n"
}

# Resolves an upstream path (relative to a Source root, "." for the whole
# repository) to an absolute directory, or returns 1. Every segment is screened
# and the resolved result must still sit inside the Source root, so a symlink
# in a Source tree cannot point Adoption at something outside it.
resolve_upstream_dir() {
  local src_root="$1" rel="${2:-.}"
  local dir real root_real

  if [ "$rel" = "." ] || [ -z "$rel" ]; then
    dir="$src_root"
  else
    case "$rel" in
      /*) return 1 ;;
    esac
    local seg
    local IFS='/'
    for seg in $rel; do
      is_safe_upstream_segment "$seg" || return 1
    done
    unset IFS
    dir="$src_root/$rel"
  fi

  [ -d "$dir" ] || return 1
  real="$(cd -P "$dir" >/dev/null 2>&1 && pwd)" || return 1
  root_real="$(cd -P "$src_root" >/dev/null 2>&1 && pwd)" || return 1
  case "$real" in
    "$root_real"|"$root_real"/*) printf '%s\n' "$real" ;;
    *) return 1 ;;
  esac
}

# Prints "<status>\t<bucket>" if a Capability with this Id already exists
# anywhere in the Library, else nothing.
find_existing_capability() {
  local want="$1"
  list_capabilities | awk -F'\t' -v id="$want" '$3 == id { print $1 "\t" $2; exit }'
}

write_capability_record() {
  local dest="$1" id="$2" kind="$3" bucket="$4" source="$5" url="$6" upstream="$7" revision="$8"
  python3 - "$dest/.skima.json" "$id" "$kind" "$bucket" "$source" "$url" "$upstream" "$revision" <<'PY'
import json
import sys

out, cap_id, kind, bucket, source, url, upstream, revision = sys.argv[1:9]

payload = {
    "id": cap_id,
    "kind": kind,
    "bucket": bucket,
    "status": "active",
    "provenance": {
        "source": source,
        "url": url,
        "path": upstream,
        "revision": revision,
    },
}

with open(out, "w", encoding="utf-8") as f:
    json.dump(payload, f, indent=2)
    f.write("\n")
PY
}

cmd_adopt() {
  ensure_sources_json_or_die
  need_cmd rsync

  local source_name="" upstream_path="" bucket="" kind="" cap_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bucket) bucket="${2:-}"; shift 2 || true ;;
      --bucket=*) bucket="${1#--bucket=}"; shift ;;
      --kind) kind="${2:-}"; shift 2 || true ;;
      --kind=*) kind="${1#--kind=}"; shift ;;
      --id) cap_id="${2:-}"; shift 2 || true ;;
      --id=*) cap_id="${1#--id=}"; shift ;;
      -*)
        echo "skima adopt: unknown option '$1'" >&2
        exit 2
        ;;
      *)
        if [ -z "$source_name" ]; then
          source_name="$1"
        elif [ -z "$upstream_path" ]; then
          upstream_path="$1"
        else
          echo "skima adopt: unexpected argument '$1'" >&2
          exit 2
        fi
        shift
        ;;
    esac
  done

  if [ -z "$source_name" ]; then
    echo "skima adopt: usage: skima adopt <source> [upstream-path] --bucket <bucket> [--kind <kind>] [--id <id>]" >&2
    exit 2
  fi
  [ -n "$upstream_path" ] || upstream_path="."

  if [ -z "$bucket" ]; then
    echo "skima adopt: --bucket is required (Adoption chooses a Bucket deliberately)" >&2
    exit 2
  fi
  if ! is_safe_name "$bucket" || [ "$bucket" = "deprecated" ]; then
    echo "skima adopt: '$bucket' is not a usable Bucket name" >&2
    exit 2
  fi

  local url src_rel revision
  if ! IFS="$FS" read -r url src_rel revision < <(source_record "$source_name"); then
    echo "skima adopt: unknown source '$source_name' (not in sources.json)" >&2
    exit 2
  fi
  [ -n "$src_rel" ] || src_rel="sources/$source_name"

  local src_dir
  if ! src_dir="$(resolve_upstream_dir "$ROOT/$src_rel" "$upstream_path")"; then
    echo "skima adopt: '$upstream_path' is not a directory inside $src_rel/" >&2
    exit 2
  fi

  # ADR-0006: the Id is the upstream directory name. For a whole-repository
  # Capability ("." — a repo that is itself one plugin) there is no upstream
  # directory below the root, so the Source name is the only honest Id.
  if [ -z "$cap_id" ]; then
    if [ "$upstream_path" = "." ]; then
      cap_id="$source_name"
    else
      cap_id="$(basename "$src_dir")"
    fi
  fi
  if ! is_safe_name "$cap_id"; then
    echo "skima adopt: '$cap_id' is not a usable Capability Id" >&2
    exit 2
  fi

  if [ -z "$kind" ]; then
    if [ -f "$src_dir/.claude-plugin/plugin.json" ]; then
      kind="plugin"
    else
      kind="skill"
    fi
  fi
  case " $VALID_KINDS " in
    *" $kind "*) ;;
    *)
      echo "skima adopt: unknown kind '$kind' (expected one of: $VALID_KINDS)" >&2
      exit 2
      ;;
  esac

  local existing
  existing="$(find_existing_capability "$cap_id")"
  if [ -n "$existing" ]; then
    local ex_status ex_bucket
    IFS=$'\t' read -r ex_status ex_bucket <<< "$existing"
    echo "skima adopt: '$cap_id' is already in the Library ($ex_status, bucket '$ex_bucket')." >&2
    echo "  Adoption never overwrites a Library copy. Update it through Change review instead." >&2
    exit 1
  fi

  local bucket_dir="$LIBRARY_DIR/$bucket"
  local dest="$bucket_dir/$cap_id"
  local staged="$bucket_dir/.$cap_id.skima-adopt-$$"

  if ! mkdir -p "$bucket_dir" 2>/dev/null; then
    echo "skima adopt: could not create bucket directory $(rel_path "$bucket_dir")" >&2
    exit 1
  fi

  rm -rf -- "$staged" 2>/dev/null || true
  if ! mkdir "$staged" 2>/dev/null; then
    echo "skima adopt: could not stage the Library copy" >&2
    exit 1
  fi

  # Stage the whole copy first, then rename it into place, so an interrupted
  # adopt leaves a hidden temp directory rather than a half-populated
  # Capability that Install would happily push to every Agent.
  if ! rsync -a --exclude='.git' --exclude='.DS_Store' "$src_dir/" "$staged/"; then
    rm -rf -- "$staged" 2>/dev/null || true
    echo "skima adopt: could not copy $src_rel/$upstream_path into the Library" >&2
    exit 1
  fi

  # The Library copy is Skima's, so its record is Skima's too — an upstream
  # .skima.json (if one ever appeared) must not survive as provenance.
  write_capability_record "$staged" "$cap_id" "$kind" "$bucket" "$source_name" "$url" "$upstream_path" "$revision"

  if ! mv -- "$staged" "$dest" 2>/dev/null; then
    rm -rf -- "$staged" 2>/dev/null || true
    echo "skima adopt: could not move the staged copy into place" >&2
    exit 1
  fi

  local row="${cap_id}${FS}${kind}${FS}${bucket}${FS}$(rel_path "$dest")${FS}${source_name}${FS}${upstream_path}${FS}${revision}"
  if printf '%s\n' "$row" | render adopt; then
    return 0
  fi

  echo "Adopted $cap_id"
  echo "  kind:       $kind"
  echo "  bucket:     $bucket"
  echo "  library:    $(rel_path "$dest")"
  echo "  provenance: $source_name $upstream_path @ ${revision:0:12}"
  echo
  echo "Run 'skima install' to make it available on every detected Install target."
}

cmd_status() {
  need_cmd python3
  if [ ! -f "$STATUS_FILE" ]; then
    echo "No status recorded yet — run 'skima check' first."
    return 0
  fi

  if render status "$STATUS_FILE"; then
    return 0
  fi

  python3 - "$STATUS_FILE" "$COLOR_ENABLED" <<'PY'
import json
import sys

path = sys.argv[1]
color = sys.argv[2] == "1"

RESET, BOLD, GREEN, YELLOW, RED = ("\033[0m", "\033[1m", "\033[32m", "\033[33m", "\033[31m") if color else ("", "", "", "", "")
STATUS_COLOR = {"up-to-date": GREEN, "behind": YELLOW, "unreachable": RED}

with open(path, encoding="utf-8") as f:
    data = json.load(f)

checked_at = data.get("checked_at", "unknown")
sources = data.get("sources", {}) or {}

print(f"Skima status  {BOLD}(checked_at: {checked_at}){RESET}")
print()

if not sources:
    print("No sources recorded.")
    sys.exit(0)

names = sorted(sources)
name_w = max(len("NAME"), max(len(n) for n in names))

print(f"{BOLD}{'NAME':<{name_w}}  {'PINNED':<12}  {'REMOTE':<12}  STATUS{RESET}")
counts = {}
for name in names:
    s = sources[name] or {}
    pinned = (s.get("pinned") or "")[:12] or "—"
    remote = (s.get("remote") or "")[:12] or "—"
    status = s.get("status", "unknown")
    counts[status] = counts.get(status, 0) + 1
    c = STATUS_COLOR.get(status, "")
    print(f"{name:<{name_w}}  {pinned:<12}  {remote:<12}  {c}{status}{RESET}")

print()
print("  ".join(f"{k}: {v}" for k, v in sorted(counts.items())))
if any(s.get("error") for s in sources.values()):
    print()
    print("Errors:")
    for name in names:
        err = (sources[name] or {}).get("error")
        if err:
            print(f"  {name}: {err}")
PY
}

usage() {
  if render help; then
    return 0
  fi
  usage_plain
}

usage_plain() {
  cat <<'EOF'
skima — personal control plane for installing agent capabilities

Usage:
  skima check        Compare each Source's pinned Revision to its remote HEAD
                      (git ls-remote, no clone). Prints a table and writes
                      .skima/status.json. Exits 1 only when every Source is
                      unreachable.
  skima sync [name...]
                      Refresh Source tree(s) from remote HEAD: shallow clone,
                      rsync into sources/<name>/ (excluding .git), update the
                      pinned Revision in sources.json, then re-check just
                      those Sources and merge into .skima/status.json. With no
                      names, refreshes every Source. Never touches library/ —
                      Adoption into the Library stays a deliberate step.
  skima adopt <source> [upstream-path] --bucket <bucket> [--kind <kind>] [--id <id>]
                      Adopt a Capability out of a Source tree into the Library
                      as an editable Library copy, with provenance pinned to
                      that Source's current Revision. upstream-path is relative
                      to sources/<source>/ and defaults to "." (the whole
                      repository). The Id defaults to the upstream directory
                      name; the Kind is inferred (plugin if the directory ships
                      .claude-plugin/plugin.json, else skill). Refuses if the
                      Id is already in the Library — updating an existing
                      Library copy is a Change review decision, not a re-adopt.
                      The Web UI's "Add to Library" runs this same command.
  skima status        Pretty-print .skima/status.json (run 'skima check'
                      first if it doesn't exist yet).
  skima install       Install every active Capability into each detected
                      Install target (symlink first, copy fallback). Agents
                      that are not detected are skipped; no directory is
                      created for them.
  skima list          List active Capabilities with their Bucket, plus any
                      Library validation warnings.
  skima targets       Show which Agents were detected and which were skipped.
  skima root          Print the monorepo root.
  skima help          Show this help.

Env:
  NO_COLOR              Disable colored output (also disabled when not a TTY).
  SKIMA_NETWORK_TIMEOUT Seconds to wait per network call before treating a
                         Source as unreachable (default: 10).

Exit codes:
  0 success   1 operational failure   2 usage error   3 missing dependency
EOF
}

main() {
  local cmd="${1:-help}"
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$cmd" in
    check) cmd_check ;;
    sync) cmd_sync "$@" ;;
    adopt) cmd_adopt "$@" ;;
    status) cmd_status ;;
    install) cmd_install ;;
    list) cmd_list ;;
    targets) cmd_targets ;;
    root) cmd_root ;;
    help|-h|--help) usage ;;
    *)
      # Plain, always: this goes to stderr, and the renderer only ever writes
      # to stdout.
      echo "skima: unknown command '$cmd'" >&2
      usage_plain >&2
      exit 2
      ;;
  esac
}

main "$@"
